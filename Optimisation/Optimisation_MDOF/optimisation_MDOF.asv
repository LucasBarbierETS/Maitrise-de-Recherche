%% ========================================================================
%  FONCTIONS INTERNES
% ========================================================================

function HV = hypervolume(P, ref)
    if isempty(P), HV = 0; return; end
    sorted = sortrows(P,1);
    HV = 0; prev_f1 = ref(1);
    for i = size(P,1):-1:1
        f1 = sorted(i,1); f2 = sorted(i,2);
        HV = HV + (prev_f1 - f1) * (ref(2) - f2);
        prev_f1 = f1;
    end
end

function d = spread(P)
    if size(P,1) < 3, d = NaN; return; end
    P = sortrows(P);
    di = sqrt(sum(diff(P).^2,2));
    d_mean = mean(di);
    d = (abs(di(1)-d_mean) + abs(di(end)-d_mean) + sum(abs(di - d_mean))) ...
        / ((size(P,1)-1) * d_mean);
end

function C = convergence(P, ideal)
    C = mean(sqrt(sum((P - ideal).^2, 2)));
end

function P_red = reduce_front_crowding(P, Nref)
    % P : N×M, front non dominé
    % Nref : nombre cible de points
    N = size(P,1);
    if N <= Nref
        P_red = P;
        return;
    end

    M = size(P,2);
    crowd = zeros(N,1);

    % Crowding distance façon NSGA-II
    for m = 1:M
        [vals, idx] = sort(P(:,m));
        crowd(idx(1))   = Inf;
        crowd(idx(end)) = Inf;
        denom = vals(end) - vals(1);
        if denom == 0
            continue;
        end
        for i = 2:N-1
            crowd(idx(i)) = crowd(idx(i)) + ...
                (vals(i+1) - vals(i-1)) / denom;
        end
    end

    % On garde les Nref points les plus "éloignés"
    [~, order] = sort(crowd, 'descend');
    keepIdx = order(1:Nref);
    P_red = P(keepIdx, :);
end


%% Fréquences cibles, Gabarits

% % Objectif larges bande

Frequences.f_min_lb = 200;
Frequences.f_max_lb = 1500;
g_obj_lb = @(env) (env.w / (2*pi) > Frequences.f_min_lb & env.w / (2*pi) < Frequences.f_max_lb);

% Première harmonique (Fondamentale) : 233 Hz (20 Hz)
Frequences.f_min_h1 = 220;
Frequences.f_max_h1 = 240;
g_obj_h1 = @(env) (env.w / (2*pi) > Frequences.f_min_h1 & env.w / (2*pi) < Frequences.f_max_h1);

% Deuxième harmonique : 467 Hz (40 Hz)
Frequences.f_min_h2 = 430;
Frequences.f_max_h2 = 470;
g_obj_h2 = @(env) (env.w / (2*pi) > Frequences.f_min_h2 & env.w / (2*pi) < Frequences.f_max_h2);

% Troisième harmonique : 700 Hz (60 Hz)
Frequences.f_min_h3 = 640;
Frequences.f_max_h3 = 700;
g_obj_h3 = @(env) (env.w / (2*pi) > Frequences.f_min_h3 & env.w / (2*pi) < Frequences.f_max_h3);

% Quatrième harmonique : 933 Hz (80 Hz)
Frequences.f_min_h4 = 870;
Frequences.f_max_h4 = 950;
g_obj_h4 = @(env) (env.w / (2*pi) > Frequences.f_min_h4 & env.w / (2*pi) < Frequences.f_max_h4);

g_obj_harm =  @(env) g_obj_h1(env) + g_obj_h2(env) + g_obj_h3(env) + g_obj_h4(env) > 0;

%% Niveau Sonore, Ecoulement

dB = 134;
% dB = 120;
M = 0.1;
env = handle_env(dB, M);
env0 = handle_env(dB, 0);

%% Paramètres géométriques invariants

total_thickness = 117e-3;
width = 30e-3;
depth = 30e-3;
total_surface = width * depth;
cavities_width = 28e-3; 
cavities_depth = 28e-3; 
acoustic_section = cavities_width * cavities_depth;
input_surface = width * depth;
plates_thickness = 2e-3;
rigid_backing_thickness = 1e-3;
depth_holes_number = 10;
depth_holes_distance = cavities_depth / (depth_holes_number + 1);

%% Structure des variables optimisées

NS = 4; % Nombre de MPP + cavité optimisés
NV = 3; % Nombre de variables pour chaque solution rayon des perforations, nombre de perfs en largeur, nombre de perf en profondeur

cavities_total_thickness = total_thickness - plates_thickness;

NP = 25; % nombre de points de départ (parents)

% Récupération des parties du vecteur d'optimisation
config = @(x) reshape(x, NS, NV);

%% Valeurs minimales en fonction du type de variable

% Solution ETS
r_min = 0.2e-3;
n_min = 1;

lb = horzcat(repmat(r_min, 1, NS), repmat(n_min, 1, 2 * NS));

%% Valeurs maximales en fonction du type de variable

% Solution ETS
r_max = 1e-3;
n_max = 20;

ub = horzcat(repmat(r_max, 1, NS), repmat(n_max, 1, 2 * NS));

%% Valeurs initiales en fonction du type de variable

r_init = r_min + (r_max - r_min) * rand(NP, NS);
n_init = n_min + (n_max - n_min) * rand(NP, 2 * NS);

x0 = horzcat(r_init, n_init);


%% Contrainte sur les variables entières

intcon = find([zeros(1, NS), ones(1, 2 * NS)]);

%% Création dynamique des MPPSBHs

Objects = struct();

Objects.Plate = @(config, i)classMPP_Circular(classMPP_Circular.create_config(acoustic_section, ...
                                                                   plates_thickness, config(i, 1), config(i, 2) * config(i, 3) * pi * config(i, 1)^2 / acoustic_section));

Objects.Cavity = classcavity(classcavity_rectangular.create_config(cavities_total_thickness, cavities_width, cavities_depth));

Objects.SDOF = @(config, i) classelement(classelement.create_config({Objects.Plate(config, i), Objects.Cavity}, 'closed', total_surface));


Objects.cell_of_SDOF = @(x) arrayfun(@(i) Objects.SDOF(config(x), i), 1:NS ,'UniformOutput', false);
Objects.assembly_of_SDOF = @(x) classelementassembly(classelementassembly.create_config(Objects.cell_of_SDOF(x)));


%% Fonctions coût

% Définition de la cartouche sur laquelle l'optimisation à lieu
handle_alpha = @(x, env, g_obj) subsref(Objects.assembly_of_SDOF(x).absorption_coefficient(env, struct('HL_method', 'linear')), substruct('()', {g_obj(env)}));
handle_cost_function = @(x, env, g_obj) mean(1 - handle_alpha(x, env, g_obj));
handle_objective = @(x, env, g_obj_cell) arrayfun(@(i) handle_cost_function(x, env, g_obj_cell{i}), 1:length(g_obj_cell) ,'UniformOutput', false);

% objective = @(x) cell2mat(handle_objective(x, env, {g_obj_h1, g_obj_h2})); 
objective = @(x) cell2mat(handle_objective(x, env, {g_obj_h1, g_obj_h2, g_obj_h3, g_obj_h4, g_obj_lb}));



