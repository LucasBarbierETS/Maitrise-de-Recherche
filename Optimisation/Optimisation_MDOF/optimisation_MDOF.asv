%% =========================================================================
%  MODULE : ÉTUDE DE L’IMPACT DU NOMBRE DE POINTS DE DÉPART
%           ET DU TYPE D’INITIALISATION
%           (GA vs NSGA-II custom)
% =========================================================================

disp("=== Lancement de l'étude PopSize × InitType (GA + NSGA2) ===");

%% 1) Définition du problème multi-objectifs
numVars = numel(lb);

problem.objective = objective;
problem.lb        = lb;
problem.ub        = ub;
problem.intcon    = intcon;
problem.nonlcon   = [];

M = 5;   % nombre d'objectifs
refPoint   = ones(1,M);
idealPoint = zeros(1,M);

%% 2) Populations et types d'initialisation testés

popSizes = [10 25 50];
initTypes = {
    'random'      % uniforme, ton actuel
    'latin'       % meilleur remplissage de l’espace
    'clustered'   % autour de zones prometteuses
};

%% 3) Stockage
results = struct();
expID = 1;

%% =========================================================================
%  MODULE 1 : GÉNÉRATION DES POPULATIONS INITIALES
% =========================================================================

disp("=== MODULE 1 : Génération des populations initiales ===");

analysis = struct();
ID = 1;

for ps = popSizes
    for it = 1:length(initTypes)

        initType = initTypes{it};

        % ---- Génération population ----
        x0_test = generate_initial_population(initType, ps, lb, ub, NS * NV);

        % ---- Découpage variables ----
        X = reshape(x0_test, ps, NS * NV);

        r_vals  = X(:, 1:NS);
        nL_vals = X(:, NS+1 : 2*NS);
        nP_vals = X(:, 2*NS+1 : 3*NS);

        porosity = nL_vals .* nP_vals .* (pi .* r_vals.^2) / acoustic_section;

        % ---- Stockage ----
        analysis(ID).PopSize  = ps;
        analysis(ID).InitType = initType;
        analysis(ID).X0       = x0_test;
        analysis(ID).r        = r_vals;
        analysis(ID).nL       = nL_vals;
        analysis(ID).nP       = nP_vals;
        analysis(ID).Porosity = porosity;

        ID = ID + 1;
    end
end

disp("=== Populations initiales générées ===");


%% =========================================================================
%  MODULE 2 : ANALYSE DES DISTRIBUTIONS INITIALES
% =========================================================================

disp("=== MODULE 2 : Analyse distributions ===");

% Liste unique pour les légendes
uniqueTypes = initTypes;

%% --- A) Boxplots rayon, nL, Porosité ---

figure;
tiledlayout(3,1);

% --- Rayon ---
nexttile; hold on; title("Distribution Rayon r");
for it = 1:length(uniqueTypes)
    idx = find(strcmp({analysis.InitType}, uniqueTypes{it}));
    r_all = vertcat(analysis(idx).r);
    boxchart(r_all(:));
end
legend(uniqueTypes);

% --- Nombre perf largeur ---
nexttile; hold on; title("Distribution Nb perfs largeur nL");
for it = 1:length(uniqueTypes)
    idx = find(strcmp({analysis.InitType}, uniqueTypes{it}));
    nL_all = vertcat(analysis(idx).nL);
    boxchart(nL_all(:));
end
legend(uniqueTypes);

% --- Porosité ---
nexttile; hold on; title("Distribution Porosité");
for it = 1:length(uniqueTypes)
    idx = find(strcmp({analysis.InitType}, uniqueTypes{it}));
    poro_all = vertcat(analysis(idx).Porosity);
    boxchart(poro_all(:));
end
legend(uniqueTypes);


%% --- B) Histogrammes comparés sur la porosité ---

figure; hold on; grid on; title("Histogrammes porosité");
for it = 1:length(uniqueTypes)
    idx = find(strcmp({analysis.InitType}, uniqueTypes{it}));
    poro_all = vertcat(analysis(idx).Porosity);
    histogram(poro_all(:), 25, "Normalization","pdf");
end
legend(uniqueTypes);
xlabel("Porosité"); ylabel("PDF");


%% --- C) Scatter rayon vs porosité ---

figure; hold on; grid on; title("r vs Porosité selon init");

colors = lines(length(uniqueTypes));

for it = 1:length(uniqueTypes)
    idx = find(strcmp({analysis.InitType}, uniqueTypes{it}));
    r_all = vertcat(analysis(idx).r);
    poro_all = vertcat(analysis(idx).Porosity);
    scatter(r_all(:), poro_all(:), 10, colors(it,:), "filled");
end

xlabel("Rayon r [m]");
ylabel("Porosité");
legend(uniqueTypes);


%% =========================================================================
%  MODULE 3 : EXPÉRIMENTATION AVEC GA / NSGA-II
% =========================================================================

disp("=== MODULE 3 : Évaluation GA/NSGA2 ===");

results = struct();
expID = 1;

for k = 1:length(analysis)

    x0_test = analysis(k).X0;
    ps      = analysis(k).PopSize;
    initType = analysis(k).InitType;

    fprintf("\n--- PopSize = %d | Init = %s ---\n", ps, initType);

    %% ===== GA (gamultiobj) =====
    optsGA = optimoptions("gamultiobj", ...
        "PopulationSize", ps, ...
        "InitialPopulationMatrix", x0_test, ...
        "MaxGenerations", 80, ...
        "MaxStallGenerations", 6, ...
        "FunctionTolerance", 1e-1, ...
        "ConstraintTolerance", 1e-6, ...
        "Display","none");

    tic;
    [Xga, Pga] = gamultiobj(problem.objective, numVars, ...
                            [],[],[],[], ...
                            problem.lb, problem.ub, ...
                            problem.nonlcon, problem.intcon, optsGA);
    tGA = toc;

    results(expID).Algo = "GA";
    results(expID).Pop = ps;
    results(expID).Init = initType;

    results(expID).Pareto = Pga;     % valeurs objectives
    results(expID).X = Xga;          % === parametres optimisés ===

    results(expID).Hypervolume = hypervolume(Pga, refPoint);
    results(expID).Convergence = convergence(Pga, idealPoint);
    results(expID).Card = size(Pga,1);
    results(expID).Time = tGA;

    expID = expID + 1;

    %% ===== NSGA2 custom (si activé) =====
    % optsNSGA.x0 = x0_test;
    % [Xnsga, Pnsga] = nsga2_moea(problem, optsNSGA);
    %
    % results(expID).X = Xnsga;
    % ... etc
end

disp("=== FIN MODULE 3 ===");


%% =========================================================================
%  MODULE 4 : POST-TRAITEMENT DES PARAMÈTRES OPTIMISÉS
% =========================================================================

disp("=== POST-TRAITEMENT : Analyse des solutions optimisées ===");

optAnalysis = struct();
OID = 1;

for k = 1:length(results)

    % --- Meta-données
    algo = results(k).Algo;
    ps   = results(k).Pop;
    init = results(k).Init;

    if ~isfield(results(k), "X")
        warning("Pas de X dans results(k). Le post-traitement saute cet item.");
        continue;
    end

    Xopt = results(k).X;   % (Npoints × Nvars)
    Npts = size(Xopt,1);

    % ---- Décomposition des variables optimisées ----
    r_vals  = Xopt(:, 1:NS);
    nL_vals = Xopt(:, NS+1 : 2*NS);
    nP_vals = Xopt(:, 2*NS+1 : 3*NS);

    porosity = nL_vals .* nP_vals .* (pi .* r_vals.^2) / acoustic_section;

    % ---- Stockage ----
    optAnalysis(OID).Algo     = algo;
    optAnalysis(OID).PopSize  = ps;
    optAnalysis(OID).InitType = init;

    optAnalysis(OID).r        = r_vals;
    optAnalysis(OID).nL       = nL_vals;
    optAnalysis(OID).nP       = nP_vals;
    optAnalysis(OID).Porosity = porosity;

    OID = OID + 1;
end

disp("=== FIN POST-TRAITEMENT (paramètres optimisés) ===");

%% =========================================================================
%  MODULE 5 : VISUALISATION DES PARAMÈTRES OPTIMISÉS
% =========================================================================

disp("=== MODULE 5 : Visualisation des distributions optimisées ===");

if isempty(optAnalysis)
    warning("optAnalysis est vide : aucune solution optimisée n’a été enregistrée.");
    return;
end

% --- Récupération listes uniques ---
optPops  = unique([optAnalysis.PopSize]);
optInits = unique(string({optAnalysis.InitType}));
optAlgos = unique(string({optAnalysis.Algo}));

%% 1) Histogrammes du rayon optimisé
figure; tiledlayout(length(optInits), length(optPops), "TileSpacing","compact");

for i = 1:length(optInits)
    for j = 1:length(optPops)

        % sélection des entrées correspondantes
        idx = find([optAnalysis.PopSize] == optPops(j) & ...
                   string({optAnalysis.InitType}) == optInits(i));

        nexttile;
        hold on;

        if isempty(idx)
            title(sprintf("Pop=%d | Init=%s\n(no data)", optPops(j), optInits(i)));
            continue;
        end

        % concatène tous les r de cette famille
        rAll = cell2mat(arrayfun(@(s) s.r(:), optAnalysis(idx), 'UniformOutput', false));

        histogram(rAll, 20, 'Normalization','pdf');
        title(sprintf("Pop=%d | Init=%s", optPops(j), optInits(i)));
        xlabel("Rayon r (m)");
        ylabel("PDF");

    end
end

sgtitle("Distribution du rayon optimisé r pour chaque PopSize × InitType");

%% 2) Histogrammes porosité
figure; tiledlayout(length(optInits), length(optPops), "TileSpacing","compact");

for i = 1:length(optInits)
    for j = 1:length(optPops)

        idx = find([optAnalysis.PopSize] == optPops(j) & ...
                   string({optAnalysis.InitType}) == optInits(i));

        nexttile;
        hold on;

        if isempty(idx)
            title(sprintf("Pop=%d | Init=%s (no data)", optPops(j), optInits(i)));
            continue;
        end

        porAll = cell2mat(arrayfun(@(s) s.Porosity(:), optAnalysis(idx), 'UniformOutput', false));

        histogram(porAll, 20, 'Normalization','pdf');
        title(sprintf("Pop=%d | Init=%s", optPops(j), optInits(i)));
        xlabel("Porosité");
        ylabel("PDF");

    end
end

sgtitle("Distribution de la porosité optimisée pour chaque PopSize × InitType");

%% 3) Scatter 2D (r vs porosité)
figure; hold on; grid on;
title("Relation r – Porosité (toutes solutions optimisées)");
xlabel("Rayon r (m)");
ylabel("Porosité");

cmap = lines(numel(optAnalysis));

for k = 1:length(optAnalysis)
    r = optAnalysis(k).r(:);
    por = optAnalysis(k).Porosity(:);
    scatter(r, por, 12, 'filled', 'MarkerFaceColor', cmap(k,:));
end

legend("AutoUpdate","off");




%% =========================================================================
%  POST-TRAITEMENT : Impact PopSize × InitType (GA vs NSGA2)
% =========================================================================

disp("=== POST-TRAITEMENT PopSize × InitType ===");

%% 1) Extraction des champs depuis results

Algos   = string({results.Algo});
Pops    = [results.Pop];
Inits   = string({results.Init});
HV      = [results.Hypervolume];
Conv    = [results.Convergence];

popList  = unique(Pops);
initList = unique(Inits);
algoList = unique(Algos);

%% =========================================================================
% 2) HYPERVOLUME vs PopSize (séparé par INIT, pour chaque ALGOS)
% =========================================================================

for a = 1:length(algoList)
    algo = algoList(a);

    figure; hold on; grid on;
    title("Hypervolume vs PopSize — Algo : " + algo);
    xlabel("Population initiale");
    ylabel("Hypervolume");

    for i = 1:length(initList)
        init = initList(i);

        idx = (Algos == algo) & (Inits == init);
        if any(idx)
            plot(Pops(idx), HV(idx), "-o", "LineWidth", 1.4, ...
                "DisplayName", init);
        end
    end

    legend("show", "Location", "best");
end

%% =========================================================================
% 3) CONVERGENCE vs PopSize (séparé par INIT, pour chaque ALGOS)
% =========================================================================

for a = 1:length(algoList)
    algo = algoList(a);

    figure; hold on; grid on;
    title("Convergence vs PopSize — Algo : " + algo);
    xlabel("Population initiale");
    ylabel("Convergence (distance au point idéal)");

    for i = 1:length(initList)
        init = initList(i);

        idx = (Algos == algo) & (Inits == init);
        if any(idx)
            plot(Pops(idx), Conv(idx), "-s", "LineWidth", 1.4, ...
                "DisplayName", init);
        end
    end

    legend("show", "Location", "best");
end

%% =========================================================================
% 4) HEATMAP HYPERVOLUME pour chaque algorithme
% =========================================================================

for a = 1:length(algoList)
    algo = algoList(a);

    HVmat = nan(length(popList), length(initList));

    for ip = 1:length(popList)
        for ii = 1:length(initList)
            idx = (Pops == popList(ip)) & (Inits == initList(ii)) & (Algos == algo);
            if any(idx)
                HVmat(ip,ii) = HV(idx);
            end
        end
    end

    figure;
    heatmap(initList, string(popList), HVmat);
    xlabel("Initialisation");
    ylabel("Population initiale");
    title("Heatmap — Hypervolume — Algo : " + algo);
end

%% =========================================================================
% 5) HEATMAP CONVERGENCE pour chaque algorithme
% =========================================================================

for a = 1:length(algoList)
    algo = algoList(a);

    Cmat = nan(length(popList), length(initList));

    for ip = 1:length(popList)
        for ii = 1:length(initList)
            idx = (Pops == popList(ip)) & (Inits == initList(ii)) & (Algos == algo);
            if any(idx)
                Cmat(ip,ii) = Conv(idx);
            end
        end
    end

    figure;
    heatmap(initList, string(popList), Cmat);
    xlabel("Initialisation");
    ylabel("Population initiale");
    title("Heatmap — Convergence — Algo : " + algo);
end

%% =========================================================================
% 6) Tableau résumé
% =========================================================================

T = table( ...
    Algos.', ...
    Pops.', ...
    Inits.', ...
    HV.', ...
    Conv.', ...
    'VariableNames', ...
    {'Algo','PopSize','Init','Hypervolume','Convergence'} ...
);

disp("=== TABLEAU RÉCAPITULATIF ===");
disp(T);

disp("=== FIN POST-TRAITEMENT ===");