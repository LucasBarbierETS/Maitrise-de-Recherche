function h = draw_png_with_border(obj, ax, imgPath, options)
% DESSINE UN PICTOGRAMME PNG AVEC BORDURE CARRÉE (méthode d'objet)
%
% Exemple :
%   h = draw_png_with_border(obj, ax, imgPath)
%   h = draw_png_with_border(obj, ax, imgPath, Size=0.6, EdgeColor='r', X=3, Y=2)
%
% Paramètres nommés :
%   Size      : taille nominale du pictogramme (défaut = 0.5)
%   EdgeColor : couleur de la bordure (défaut = 'k')
%   LineWidth : épaisseur de bordure (défaut = 1.5)
%   X         : position X (défaut = obj.Index si dispo, sinon 1)
%   Y         : position Y (défaut = 1)
%   Tag       : tag du groupe (défaut = 'picto_<TypeName>')

    arguments
        obj
        ax (1,1) matlab.ui.control.UIAxes
        imgPath (1,:) char {mustBeFile}

        options.Size (1,1) double {mustBePositive} = 0.5
        options.EdgeColor = 'k'
        options.LineWidth (1,1) double {mustBePositive} = 1.5
        options.X double = []
        options.Y double = []
        options.Tag string = ""
    end

    % === Récupération des paramètres ===
    s        = options.Size;
    edgeCol  = options.EdgeColor;
    lw       = options.LineWidth;
    x        = options.X;
    y        = options.Y;
    tag      = char(options.Tag);

    % === Déterminer X/Y par défaut à partir de l'objet ===
    if isempty(x)
        if isprop(obj, 'Index') && ~isempty(obj.Index)
            x = obj.Index;
        elseif isprop(obj, 'X') && ~isempty(obj.X)
            x = obj.X;
        else
            x = 1;
        end
    end
    if isempty(y)
        if isprop(obj, 'Y') && ~isempty(obj.Y)
            y = obj.Y;
        else
            y = 1;
        end
    end

    % === Déterminer le tag par défaut ===
    if isempty(tag)
        if isprop(obj, 'TypeName') && ~isempty(obj.TypeName)
            tag = ['picto_' char(obj.TypeName)];
        else
            tag = 'picto_png';
        end
    end

    % === Lecture du PNG (flip vertical pour uiaxes) == 
    img = flipud(imread(imgPath));
    if isfield(obj, 'Container') && ~isempty(obj.Container) &&  isfield(obj.Container, 'Container') && ~isempty(obj.Container.Container) && isa(obj.Container.Container, 'AppElement')
        img = rot90(img);
    end

    % === Coordonnées d’affichage ===
    xRange = [x - s/2, x + s/2];
    yRange = [y - s/2, y + s/2];

    % === Affichage de l’image ===
    hold(ax, 'on');
    hImg = image(ax, 'CData', img, 'XData', xRange, 'YData', yRange, 'HitTest', 'off');

    % Forcer orientation “mathématique”
    if isprop(ax, 'YDir') && ~strcmpi(ax.YDir, 'normal')
        ax.YDir = 'normal';
    end

    % === Création de la bordure carrée ===
    borderSize = s * 1.05;
    hBorder = rectangle(ax, ...
        'Position', [x - borderSize/2, y - borderSize/2, borderSize, borderSize], ...
        'EdgeColor', edgeCol, ...
        'LineWidth', lw, ...
        'FaceColor', 'none', ...
        'HitTest', 'off');

    uistack(hBorder, 'bottom');

    % === Création du groupe ===
    h = hggroup('Parent', ax, 'Tag', tag);
    set([hBorder hImg], 'Parent', h);
    set(h, 'HitTest', 'on', 'PickableParts', 'all');

    % === Stocker les métadonnées ===
    h.UserData.Border   = hBorder;
    h.UserData.Image    = hImg;
    h.UserData.BaseSize = s;
end
